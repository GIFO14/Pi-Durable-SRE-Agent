    "@earendil-works/pi-durable": "1.3.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/node": "24.10.0",
    "@types/proper-lockfile": "^4.1.4",
    "lucide-static": "^1.61.0",
    "typescript": "5.9.3"
  }
}
