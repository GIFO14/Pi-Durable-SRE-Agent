# Real agent execution. The server never silently switches to a scripted model.
# Reuses an active Codex ChatGPT session, or run npm run auth:login.
SRE_MODEL=gpt-6.1-sol
# healthy or rollback-once. Only production/deployment behavior is simulated.
SRE_SCENARIO=healthy
SRE_PORT=3000
SRE_OBSERVE_MS=8000
# Optional Bash executable (use Git Bash on Windows).
# SRE_BASH="C:/Program Files/Git/bin/bash.exe"
